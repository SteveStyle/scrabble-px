---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB
    DEV["Dev<br/>:3000 server · :8080 web"]
    STG["Staging<br/>:8081 · docker"]
    PROD["Production<br/>tileliteelite.com"]
    LG["local git<br/>working tree + history"]
    subgraph GH["GitHub"]
        REPO["repo · main"]
        ACT["Actions"]
    end

    DEV ~~~ STG
    STG ~~~ PROD
    DEV -->|"1.b · $ git commit"| LG
    LG -->|"1.c · $ git push"| REPO
    REPO -->|"1.c · CI runs (automatic)"| ACT
    ACT -.->|"1.c · $ ci-status.sh --wait"| LG
    LG -->|"1.a · $ cargo build<br/>$ services.sh restart<br/>$ cargo test"| DEV
    LG -->|"3 · $ deploy-staging.sh"| STG
    LG -->|"6 · $ deploy.sh"| PROD
    STG -.->|"4 · $ curl /health"| STG
    STG -->|"5 · user test (by hand)"| STG
    PROD -->|"2 · $ deploy-staging.sh at prod"| STG
    ACT -.->|"6 · gate: CI green"| PROD
    STG -.->|"6 · gate: same commit"| PROD
    PROD -->|"6 · tag + version bump (automatic)"| REPO
    PROD -.->|"7 · $ deploy-staging.sh verify"| STG

    classDef env fill:#e4eff8,stroke:#39698c,color:#12303f
    classDef repo fill:#f7efe0,stroke:#96763f,color:#3a2c12
    class DEV,STG,PROD env
    class LG,REPO,ACT repo
    %% Amber for the two gates. linkStyle takes edge *indices* in
    %% declaration order counting from 0, including the two invisible ~~~
    %% links — so recount these whenever an edge is added or moved, and
    %% check the render. Adding the user-test edge silently shifted them
    %% moved 11,12 -> 12,13 -> 11,12 -> 12,13 across four edits so far.
    linkStyle 12,13 stroke:#b06a2c,color:#8a4b18
    style GH fill:#fdf9f1,stroke:#96763f,color:#3a2c12
