---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TB
    %% Line language, applied consistently:
    %%   -->    code moves, in the direction it moves
    %%   -.->   an answer comes back — a query, nothing shipped
    %% Bold is an action somebody takes; normal weight is something that
    %% happens on its own or a question being asked. Bold comes from
    %% mermaid markdown strings (backtick-quoted labels) rather than <b>,
    %% which leaks literally while htmlLabels is false.
    %% .
    %% Every arrow is numbered, in the order events happen, so the whole
    %% sequence can be followed by reading the numbers. A letter suffix
    %% breaks one runbook step into its ordered parts — 1.a-1.e are things
    %% you do, 6.a-6.e are what one command does on your behalf.
    %% .
    %%   {  }   a decision on an action arrow — the action stops here and
    %%          is tested before it continues. Checks feed into it.
    %% .
    %% .
    %% The gate is a decision on the *action*, not a property of production:
    %% it happens inside deploy.sh, before anything ships, and the two
    %% checks are inputs to it. Drawing it as arrows into Production implied
    %% a relationship between Actions and Production that does not exist.
    %% .
    %% No linkStyle anywhere: the shapes carry the meaning. Edge indices
    %% silently pointed at the wrong arrows four times when they did.
    %% .
    %% Steps 3 and 6.a start at local git rather than Dev on purpose, and
    %% this is literally true of the scripts: both check the commit out into
    %% a throwaway git worktree and build that, so the working tree cannot
    %% reach either environment. Do not "correct" these to start at DEV.
    DEV["Dev<br/>working tree<br/>:3000 server · :8080 web"]
    STG["Preview<br/>:8081 · docker"]
    PROD["Production<br/>tileliteelite.com"]
    LG["local git<br/>commit history"]
    subgraph GH["GitHub"]
        REPO["repo · main"]
        ACT["Actions"]
    end


    DEV ~~~ STG
    STG ~~~ GATE
    %% Without this, ELK floats Production up beside Preview and "ships the
    %% image" points upward. Pinning it after Preview puts the environments
    %% in descending order and the deploy flow downward through the gate.
    STG ~~~ PROD

    DEV -->|"`1.a · **$ cargo build**
**$ services.sh restart**
**$ cargo test**`"| DEV
    DEV -->|"`1.b · **$ git add**
**$ git commit**`"| LG
    LG -->|"`1.c · **$ git push**`"| REPO
    REPO -->|"1.d · CI runs (automatic)"| ACT
    ACT -.->|"`1.e · **$ ci-status.sh --wait**`"| LG
    PROD -.->|"`2 · **$ deploy-preview.sh at prod**`"| STG
    LG -->|"`3 · **$ deploy-preview.sh**`"| STG
    STG -.->|"`4 · **$ curl /health**`"| STG
    STG -.->|"`5 · **user test**`"| STG
    LG -->|"`6.a · **$ deploy.sh**`"| GATE{"gate"}
    GATE -->|"6.d · ships the image"| PROD
    ACT -.->|"6.b · CI green for this commit?"| GATE
    STG -.->|"6.c · preview on this commit?"| GATE
    LG -->|"6.e · tag + version bump"| REPO
    PROD -.->|"`7 · **$ deploy-preview.sh verify**`"| STG

    classDef gate fill:#fbe9dc,stroke:#b06a2c,color:#7a4318
    classDef env fill:#e4eff8,stroke:#39698c,color:#12303f
    classDef repo fill:#f7efe0,stroke:#96763f,color:#3a2c12
    class DEV,STG,PROD env
    class LG,REPO,ACT repo
    class GATE gate
    style GH fill:#fdf9f1,stroke:#96763f,color:#3a2c12
