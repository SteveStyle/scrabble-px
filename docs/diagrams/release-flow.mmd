    LG -->|"8 · deploy.sh"| PROD
    DEV -->|"4 · user test"| DEV
    STG -->|"7 · curl /health"| STG
    PROD -->|"5 · deploy-staging.sh at prod"| STG
    ACT -.->|"8 · gate: CI green"| PROD
