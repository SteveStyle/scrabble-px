#!/usr/bin/env bash
set -euo pipefail
# pre-commit — three refusals, cheapest first.
#
# Running a check and gating on it are different things. On 2026-09-02 three
# commits went out having failed check-docs, because the check reported and the
# commit happened anyway.

REPO="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
MERGING=0
[ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ] && MERGING=1

# --- 1. an image change on `main` needs a branch ------------------------------
#
# **What ships in the image goes through a branch and a pull request.** Documents
# and scripts are live when they are pushed and need neither; the image is what
# production runs.
#
# The rule is inverted on purpose: it lists what does **not** ship, and refuses
# everything else. Listing what does ship means a build asset nobody thought of
# — a new compose file, a config the Dockerfile starts copying — is missed in
# silence. This way an unrecognised path is refused, which is noisy and visible
# and fixed by adding one line here.
#
# `crates/*/examples`, `tests` and `benches` are excluded because they are not
# built into the image. `old-crates/` is **not** excluded, though nothing in it
# is compiled into the binaries: the Dockerfile `COPY`s it into the build
# context, so changing it changes the image that gets built. `Cargo.toml` is not excluded even though it carries
# dev-dependencies: it is the file that decides what ships, and telling a dev
# dependency from a real one means parsing it.
#
# Measured over 140 commits on `main`, the old form fired once — 0b18a66f, which
# changed the Caddyfile and docker-compose.yml directly on main during #240.
# Squash merges are made by GitHub and never reach this hook; a local merge is
# skipped.
NON_SHIPPING='^(docs/|scripts/|e2e/|\.github/|\.githooks/|\.claude/|crates/[^/]+/(examples|tests|benches)/|LICENSE|\.gitignore$|\.markdownlint|.*\.md$)'
if [ "$MERGING" -eq 0 ] && [ "$BRANCH" = "main" ]; then
  IMAGE="$(printf '%s\n' "$STAGED" | grep -v '^$' | grep -vE "$NON_SHIPPING" || true)"
  if [ -n "$IMAGE" ]; then
    {
      echo "commit refused: this changes what ships in the image, on main."
      echo
      printf '  %s\n' $IMAGE
      echo
      echo "  An image change goes through a branch and a pull request — it is what"
      echo "  production runs. Documents, scripts, tests and examples are live when"
      echo "  pushed and need neither."
      echo
      echo "  git switch -c <issue>-<name> and commit there, or --no-verify with"
      echo "  the reason in the message."
      echo
      echo "  If one of those genuinely does not ship, add it to NON_SHIPPING in"
      echo "  .githooks/pre-commit and say why."
    } >&2
    exit 1
  fi
fi

# --- 2. a new artefact is registered ------------------------------------------
#
# **Something permanent needs somewhere to be found.** Not an issue — the owner,
# 2026-09-03: a quick edit should not need a requirement. A row in the register
# is the whole obligation.
#
# Five artefacts were created on 2-3 September and two were unregistered, both
# within an hour of this being written.
NEW="$(printf '%s\n' "$STAGED" | grep -E '^(scripts/[^/]+\.(sh|py)$|\.githooks/[^/]+$|\.claude/skills/[^/]+/)' || true)"
if [ -n "$NEW" ]; then
  UNREGISTERED=""
  while read -r f; do
    [ -n "$f" ] || continue
    case "$f" in */tests/*) continue ;; esac
    # a file already tracked is not new
    git ls-tree -r --name-only HEAD -- "$f" 2>/dev/null | grep -qx "$f" && continue
    name="$(basename "$f")"
    case "$f" in .claude/skills/*) name="$(printf '%s' "$f" | cut -d/ -f3)" ;; esac
    grep -qF "$name" "$REPO/docs/3.0-tools.md" 2>/dev/null || UNREGISTERED="$UNREGISTERED $f"
  done <<< "$NEW"
  if [ -n "$UNREGISTERED" ]; then
    {
      echo "commit refused: a new artefact is not in the register."
      echo
      printf '  %s\n' $UNREGISTERED
      echo
      echo "  Add a row to docs/3.0-tools.md saying what it is and what runs it."
      echo "  A row, not an issue."
    } >&2
    exit 1
  fi
fi

# --- 3. the documentation checks ----------------------------------------------
#
# The only conditional one: it reads every markdown file and takes a few
# seconds, so a commit touching no documents does not pay for it. A check that
# makes every commit slower is one people bypass.
if printf '%s\n' "$STAGED" | grep -qE '\.md$' && [ -x "$REPO/scripts/check-docs.sh" ]; then
  if ! output="$("$REPO/scripts/check-docs.sh" 2>&1)"; then
    printf '%s\n' "$output" >&2
    cat >&2 <<'MSG'

pre-commit: the documentation checks failed, so nothing was committed.

Fix what is reported above, or commit with --no-verify if you are certain —
worth explaining in the commit message, because the next person will wonder.
MSG
    exit 1
  fi
fi
